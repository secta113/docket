name: CI

on:
  push:
  pull_request:

jobs:
  rotproof:
    runs-on: ubuntu-latest
    # Without a limit, a job that hangs runs for GitHub's default of six hours
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v7
        with:
          python-version: "3.12"
      - run: python -m pip install -r requirements-dev.txt
      - run: rotproof check
